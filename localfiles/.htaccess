# Deny direct browser access to private finance files.
# Copy this folder to the WordPress root (sibling of wp-content) on the live host.
# Downloads go through the Emerson gated Members / admin-post action only.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
</IfModule>
