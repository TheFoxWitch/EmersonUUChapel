{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#000000",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#3f4fa0",
					"name": "Emerson Blue",
					"slug": "emerson-blue"
				},
				{
					"color": "#2e3a78",
					"name": "Emerson Blue Dark",
					"slug": "emerson-blue-dark"
				},
				{
					"color": "#9DFF20",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#345C00",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#F6F6F6",
					"name": "Tertiary",
					"slug": "tertiary"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--emerson-blue)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--emerson-blue-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--emerson-blue)",
					"text": "var(--wp--preset--color--white)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--emerson-blue)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--emerson-blue)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--emerson-blue)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		},
		"blocks": {
			"core/post-content": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--emerson-blue)"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--emerson-blue-dark)"
							}
						}
					}
				}
			}
		}
	}
}
